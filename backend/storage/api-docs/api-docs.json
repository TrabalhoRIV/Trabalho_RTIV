    "paths": {
        "/api/agendamentos": {
            "post": {
                "tags": [
                    "Agendamentos"
                ],
                "summary": "Cadastrar agendamento",
                "description": "Realiza o agendamento de uma consulta pelo NIR.",
                "operationId": "fc85b6e93066d4998b605da62a4dace0",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "id_solicitacao",
                                    "data_agendamento",
                                    "local"
                                ],
                                "properties": {
                                    "id_solicitacao": {
                                        "type": "integer",
                                        "example": 42
                                    },
                                    "data_agendamento": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-12-15T14:00:00"
                                    },
                                    "local": {
                                        "type": "string",
                                        "example": "Ambulatório Endocrinologia — Sala 3"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Agendamento realizado com sucesso.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "Agendado"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Usuário não autenticado."
                    },
                    "422": {
                        "description": "Dados enviados inválidos."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Realizar login",
                "description": "Autentica o usuário utilizando e-mail e senha.",
                "operationId": "535ffeda4b78916efd658b2844ea897a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "medico@hospital.gov.br"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "senha123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login realizado com sucesso."
                    },
                    "401": {
                        "description": "Credenciais inválidas."
                    },
                    "422": {
                        "description": "Dados de validação inválidos."
                    }
                }
            }
        },
