        "/api/pacientes/{prontuario}": {
            "get": {
                "tags": [
                    "Pacientes"
                ],
                "summary": "Consultar paciente pelo prontuário",
                "description": "Busca os dados de um paciente no sistema AGHU.",
                "operationId": "d72aa1685965d2bc8a96acd30047d480",
                "parameters": [
                    {
                        "name": "prontuario",
                        "in": "path",
                        "description": "Número do prontuário do paciente.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "123456"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dados do paciente encontrados.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "prontuario": {
                                            "type": "string",
                                            "example": "123456"
                                        },
                                        "nomePaciente": {
                                            "type": "string",
                                            "example": "Ana Beatriz Ferreira"
                                        },
                                        "cartaoSus": {
                                            "type": "string",
                                            "example": "7000.1234.5678.9012"
                                        },
                                        "cpf": {
                                            "type": "string",
                                            "example": "123.456.789-00"
                                        },
                                        "leito": {
                                            "type": "string",
                                            "example": "Leito 402-A"
                                        },
                                        "numeroConsulta": {
                                            "type": "string",
                                            "example": "987654"
                                        },
                                        "clinicaOrigem": {
                                            "type": "string",
                                            "example": "Clínica Médica Interna"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Paciente não encontrado no AGHU."
                    },
                    "401": {
                        "description": "Usuário não autenticado."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
